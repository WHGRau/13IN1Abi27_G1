<StackPane fx:id="background" alignment="CENTER" prefHeight="1080.0" prefWidth="1920.0" style="-fx-background-color: #E9E9D3;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ControllerLogin">
   <children>
      <AnchorPane focusTraversable="true" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="1080.0" prefWidth="1920.0" style="-fx-background-color: #E9E9D3;">
         <children>
            <ImageView fitHeight="1080.0" fitWidth="1920.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../eulen/HintergrundEulen.gif" />
               </image>
            </ImageView>
            <ImageView fitHeight="1080.0" fitWidth="1920.0" layoutX="10.0" layoutY="282.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../eulen/langeEule.png" />
               </image>
            </ImageView>
            <VBox alignment="CENTER" layoutX="845.0" layoutY="575.0" prefWidth="230.0" spacing="8.0">
               <children>
                  <TextField fx:id="emailFeld" maxWidth="195.0" onKeyPressed="#enter" prefHeight="35.0" prefWidth="195.0" promptText="E-Mail" style="-fx-font-size: 14px;" />
                  <PasswordField fx:id="passwortFeld" maxWidth="195.0" onKeyPressed="#anmeldenEnter" prefHeight="35.0" prefWidth="195.0" promptText="Passwort" style="-fx-font-size: 14px;" />
                  <Button fx:id="loginButton" mnemonicParsing="false" onAction="#login" prefHeight="32.0" prefWidth="110.0" text="anmelden" style="-fx-font-size: 14px; -fx-cursor: hand;" />
                  <Text fx:id="fehlerText" fill="#d32626" strokeType="OUTSIDE" strokeWidth="0.0" textAlignment="CENTER" wrappingWidth="220.0" />
                  <Button mnemonicParsing="false" onAction="#passwortVergessen" text="Passwort vergessen?" style="-fx-cursor: hand;">
                     <font>
                        <Font size="10.0" />
                     </font>
                  </Button>
               </children>
            </VBox>
         </children>
      </AnchorPane>
   </children>
</StackPane>
